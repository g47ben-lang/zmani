{
  "manifest_version": 3,
  "name": "SaveBridge",
  "version": "0.4.5",
  "description": "מוסיף כפתור הורדה ל-YouTube ומוריד דרך שרת SaveBridge חינמי משלך.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "SaveBridge",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*",
        "https://*.google.com/*",
        "https://*.google.co.il/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "content.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "injected.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "permissions": [
    "storage",
    "notifications",
    "downloads",
    "cookies",
    "offscreen",
    "nativeMessaging",
    "scripting"
  ],
  "host_permissions": [
    "https://*.youtube.com/*",
    "https://*.google.com/*",
    "https://*.trycloudflare.com/*",
    "https://*.run.app/*",
    "https://*.loca.lt/*",
    "https://*.ngrok-free.app/*",
    "https://*.ngrok.io/*"
  ],
  "key": ""
}
